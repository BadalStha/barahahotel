// Baraha Hotel — Prisma schema
// Pivoted to a lean, room-centric model: RoomEntry + RoomCharge.
// The public site is pure marketing/SEO; room tracking is admin-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
}

enum RoomEntryStatus {
  OCCUPIED
  CHECKED_OUT
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// ── Admin & auth ─────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
}

// ── Rooms ────────────────────────────────────────────────────────

model RoomType {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  basePrice    Decimal   @db.Decimal(10, 2)
  maxOccupancy Int
  sizeSqft     Int?
  amenities    String[]  @default([])
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rooms  Room[]
  images RoomImage[]

  @@index([isActive])
}

model Room {
  id         String     @id @default(cuid())
  roomNumber String     @unique
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])
  floor      Int        @default(1)
  status     RoomStatus @default(AVAILABLE)
  createdAt  DateTime   @default(now())

  entries RoomEntry[]

  @@index([roomTypeId])
  @@index([status])
}

model RoomImage {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  sortOrder  Int      @default(0)

  @@index([roomTypeId])
}

// ── Stays & charges ──────────────────────────────────────────────

model RoomEntry {
  id           String          @id @default(cuid())
  roomId       String
  room         Room            @relation(fields: [roomId], references: [id])
  guestName    String
  guestPhone   String?
  numGuests    Int             @default(1)
  checkIn      DateTime
  checkOut     DateTime?
  ratePerNight Decimal         @db.Decimal(10, 2)
  status       RoomEntryStatus @default(OCCUPIED)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  charges RoomCharge[]
  invoice Invoice?

  @@index([roomId])
  @@index([status])
  @@index([checkIn])
}

model RoomCharge {
  id          String   @id @default(cuid())
  roomEntryId String
  roomEntry   RoomEntry @relation(fields: [roomEntryId], references: [id], onDelete: Cascade)
  itemName    String
  quantity    Int      @default(1)
  priceAtAdd  Decimal  @db.Decimal(10, 2)
  addedAt     DateTime @default(now())

  @@index([roomEntryId])
}

// ── Invoicing ────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  roomEntryId    String        @unique
  roomEntry      RoomEntry     @relation(fields: [roomEntryId], references: [id])
  roomTotal      Decimal       @default(0) @db.Decimal(10, 2)
  chargeTotal    Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal     Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentMethod  String?
  generatedAt    DateTime      @default(now())
  paidAt         DateTime?
}

// ── Content & site ───────────────────────────────────────────────

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON encoded as text for flexible settings
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  metaTitle       String?
  metaDescription String?
  content         Json? // block-based content (headings, text, images)
  updatedAt       DateTime @updatedAt
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  content         String
  coverImageUrl   String?
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

// ── Media & social proof ─────────────────────────────────────────

model GalleryImage {
  id        String  @id @default(cuid())
  url       String
  altText   String?
  category  String?
  sortOrder Int     @default(0)
}

model Testimonial {
  id          String   @id @default(cuid())
  guestName   String
  quote       String
  rating      Int      @default(5)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}
