// Baraha Hotel — Prisma schema
// PostgreSQL datasource covering the public site, admin, bookings,
// food & beverage, invoicing, and CMS content.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum BookingSource {
  WEBSITE
  WALK_IN
  PHONE
}

enum FoodCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
  BEVERAGES
}

enum FoodOrderStatus {
  PLACED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// ── Admin & auth ─────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
}

// ── Rooms ────────────────────────────────────────────────────────

model RoomType {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  basePrice    Decimal   @db.Decimal(10, 2)
  maxOccupancy Int
  sizeSqft     Int?
  amenities    String[]  @default([])
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rooms  Room[]
  images RoomImage[]

  @@index([isActive])
}

model Room {
  id         String     @id @default(cuid())
  roomNumber String     @unique
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])
  floor      Int        @default(1)
  status     RoomStatus @default(AVAILABLE)
  createdAt  DateTime   @default(now())

  bookings Booking[]

  @@index([roomTypeId])
  @@index([status])
}

model RoomImage {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  sortOrder  Int      @default(0)

  @@index([roomTypeId])
}

// ── Guests & bookings ────────────────────────────────────────────

model Guest {
  id               String   @id @default(cuid())
  fullName         String
  email            String?
  phone            String?
  address          String?
  idDocumentType   String?
  idDocumentNumber String?
  createdAt        DateTime @default(now())

  bookings Booking[]

  @@index([email])
}

model Booking {
  id                String        @id @default(cuid())
  bookingCode       String        @unique
  guestId           String
  guest             Guest         @relation(fields: [guestId], references: [id])
  roomId            String
  room              Room          @relation(fields: [roomId], references: [id])
  checkIn           DateTime
  checkOut          DateTime
  numGuests         Int           @default(1)
  status            BookingStatus @default(PENDING)
  roomRateAtBooking Decimal       @db.Decimal(10, 2)
  source            BookingSource @default(WEBSITE)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  foodOrders FoodOrder[]
  invoice    Invoice?

  // Availability queries: date-range overlap + per-room lookups
  @@index([checkIn, checkOut])
  @@index([roomId])
  @@index([roomId, checkIn, checkOut])
  @@index([guestId])
  @@index([status])
}

// ── Food & beverage ──────────────────────────────────────────────

model FoodMenuItem {
  id          String       @id @default(cuid())
  name        String       @unique
  category    FoodCategory
  price       Decimal      @db.Decimal(10, 2)
  description String?
  isAvailable Boolean      @default(true)
  imageUrl    String?

  orderItems FoodOrderItem[]

  @@index([category])
}

model FoodOrder {
  id        String          @id @default(cuid())
  bookingId String
  booking   Booking         @relation(fields: [bookingId], references: [id])
  orderedAt DateTime        @default(now())
  status    FoodOrderStatus @default(PLACED)
  notes     String?

  items FoodOrderItem[]

  @@index([bookingId])
}

model FoodOrderItem {
  id             String       @id @default(cuid())
  foodOrderId    String
  foodOrder      FoodOrder    @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)
  foodMenuItemId String
  foodMenuItem   FoodMenuItem @relation(fields: [foodMenuItemId], references: [id])
  quantity       Int          @default(1)
  priceAtOrder   Decimal      @db.Decimal(10, 2)

  @@index([foodOrderId])
  @@index([foodMenuItemId])
}

// ── Invoicing ────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id])
  roomTotal      Decimal       @default(0) @db.Decimal(10, 2)
  foodTotal      Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal     Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentMethod  String?
  generatedAt    DateTime      @default(now())
  paidAt         DateTime?
}

// ── Content & site ───────────────────────────────────────────────

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON encoded as text for flexible settings
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  metaTitle       String?
  metaDescription String?
  content         Json? // block-based content (headings, text, images)
  updatedAt       DateTime @updatedAt
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  content         String
  coverImageUrl   String?
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

// ── Media & social proof ─────────────────────────────────────────

model GalleryImage {
  id        String  @id @default(cuid())
  url       String
  altText   String?
  category  String?
  sortOrder Int     @default(0)
}

model Testimonial {
  id          String   @id @default(cuid())
  guestName   String
  quote       String
  rating      Int      @default(5)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isPublished])
}
