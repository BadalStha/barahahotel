# ------------------------------------------------------------------
# Baraha Hotel — environment variables
# Copy this file to .env and fill in real values.
# ------------------------------------------------------------------

# PostgreSQL database (Prisma)
# App runtime connection. For Neon: use the pooled endpoint with &pgbouncer=true.
# connect_timeout/pool_timeout are raised to ~90s so the app survives Neon's
# cold-start wake (free-tier computes auto-suspend after ~5 min idle and can
# take 60s+ to wake). Keep these generous or the site 500s on cold starts.
DATABASE_URL="postgresql://user:password@localhost:5432/baraha_hotel?schema=public&connect_timeout=90&pool_timeout=90"
# Direct (unpooled) connection — used by Prisma migrations (required for Neon).
DIRECT_URL="postgresql://user:password@localhost:5432/baraha_hotel?schema=public&connect_timeout=90&pool_timeout=90"

# NextAuth / Auth.js v5
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (image uploads)
# Create a read-write token in the Vercel dashboard:
#   https://vercel.com/docs/storage/vercel-blob/using-blob-sdk
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Resend (transactional email)
RESEND_API_KEY="re_replace-with-your-resend-api-key"
# Sender address for booking confirmations (must be a verified domain in Resend)
RESEND_FROM_EMAIL="Baraha Hotel and Lodge <bookings@barahahotel.com>"

# Seed credentials (prisma/seed.ts)
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_EMAIL="admin@barahahotel.com"
